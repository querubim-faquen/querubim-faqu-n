<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Meu site profissional">
  <title>Meu Site</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f5f5f5;
      color: #222;
      line-height: 1.6;
    }

    header {
      background: #111827;
      color: white;
      padding: 18px;
      text-align: center;
    }

    header h1 {
      font-size: 28px;
    }

    nav {
      background: #1f2937;
      display: flex;
      justify-content: center;
      gap: 20px;
      padding: 12px;
      flex-wrap: wrap;
    }

    nav a {
      color: white;
      text-decoration: none;
      font-weight: bold;
    }

    nav a:hover {
      color: #38bdf8;
    }

    .hero {
      background: linear-gradient(135deg, #2563eb, #7c3aed);
      color: white;
      text-align: center;
      padding: 60px 20px;
    }

    .hero h2 {
      font-size: 34px;
      margin-bottom: 12px;
    }

    .hero p {
      font-size: 18px;
    }

    .container {
      max-width: 1100px;
      margin: auto;
      padding: 25px 15px;
    }

    .search {
      width: 100%;
      padding: 14px;
      border: 1px solid #ccc;
      border-radius: 10px;
      margin-bottom: 25px;
      font-size: 16px;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
    }

    .card {
      background: white;
      padding: 20px;
      border-radius: 12px;
      box-shadow: 0 3px 12px rgba(0,0,0,0.08);
    }

    .card h3 {
      margin-bottom: 10px;
      color: #2563eb;
    }

    .ad {
      background: #e5e7eb;
      border: 1px dashed #888;
      min-height: 90px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 25px 0;
      color: #666;
    }

    footer {
      background: #111827;
      color: white;
      text-align: center;
      padding: 25px;
      margin-top: 30px;
    }

    footer a {
      color: #38bdf8;
      margin: 0 8px;
    }

    .dark {
      background: #0f172a;
      color: #eee;
    }

    .dark .card {
      background: #1e293b;
    }

    button {
      padding: 10px 18px;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      margin-top: 15px;
      background: white;
      color: #2563eb;
      font-weight: bold;
    }
  </style>
</head>

<body>

<header>
  <h1>MEU SITE</h1>
  <p>Conteúdo, notícias e novidades</p>
</header>

<nav>
  <a href="#">Início</a>
  <a href="#conteudos">Conteúdos</a>
  <a href="#sobre">Sobre</a>
  <a href="#contacto">Contacto</a>
  <a href="#privacidade">Privacidade</a>
</nav>

<section class="hero">
  <h2>Bem-vindo ao meu site</h2>
  <p>Encontre aqui conteúdos interessantes e novidades.</p>
  <button onclick="modoEscuro()">🌙 Modo escuro</button>
</section>

<div class="container">

  <input
    type="text"
    id="pesquisa"
    class="search"
    placeholder="🔎 Pesquisar conteúdo..."
    onkeyup="pesquisar()"
  >

  <div class="ad">
    ESPAÇO PARA ANÚNCIO
  </div>

  <section id="conteudos">
    <h2>Conteúdos em destaque</h2>

    <br>

    <div class="cards">

      <article class="card">
        <h3>Primeiro conteúdo</h3>
        <p>
          Este é um exemplo de conteúdo do seu novo site.
          Você poderá substituir este texto pelos seus próprios artigos.
        </p>
      </article>

      <article class="card">
        <h3>Segundo conteúdo</h3>
        <p>
          Publique notícias, informações, vídeos ou qualquer
          outro conteúdo que desejar.
        </p>
      </article>

      <article class="card">
        <h3>Terceiro conteúdo</h3>
        <p>
          O site foi preparado para funcionar bem em celulares,
          tablets e computadores.
        </p>
      </article>

    </div>
  </section>

  <div class="ad">
    ESPAÇO PARA ANÚNCIO
  </div>

  <section id="sobre">
    <h2>Sobre nós</h2>
    <p>
      Este é o espaço onde você poderá apresentar o seu site,
      projeto ou empresa.
    </p>
  </section>

  <br>

  <section id="contacto">
    <h2>Contacto</h2>
    <p>
      Entre em contacto conosco através do nosso canal oficial.
    </p>
  </section>

</div>

<footer>
  <p>© 2026 Meu Site — Todos os direitos reservados.</p>

  <br>

  <a href="#privacidade">Política de privacidade</a>
  <a href="#">Termos de uso</a>
</footer>

<script>

function modoEscuro() {
  document.body.classList.toggle("dark");
}

function pesquisar() {

  const texto =
    document.getElementById("pesquisa").value.toLowerCase();

  const cards =
    document.querySelectorAll(".card");

  cards.forEach(function(card) {

    const conteudo =
      card.innerText.toLowerCase();

    if (conteudo.includes(texto)) {
      card.style.display = "block";
    } else {
      card.style.display = "none";
    }

  });

}

</script>

</body>
</html>
